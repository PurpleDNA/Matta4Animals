# X (Twitter) Developer Portal -> "Keys and Tokens" tab
TWITTER_API_KEY=your_api_key_aka_consumer_key
TWITTER_API_SECRET=your_api_key_secret_aka_consumer_secret
TWITTER_ACCESS_TOKEN=your_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_access_token_secret
TWITTER_BEARER_TOKEN=your_bearer_token

# Google AI Studio Credentials
GOOGLE_API_KEY=your_gemini_api_key

# Bot Configuration
DRY_RUN=True  # Set to False to actually post to Twitter
POST_TIME="10:00" # Daily post time in HH:MM format
RSS_FETCH_HOURS=48  # How far back to fetch stories from RSS feeds
MIN_SCORE_THRESHOLD=50  # Minimum score for a story to be posted
POST_HISTORY_DAYS=30  # Number of days to track posted stories
MAX_THREAD_LENGTH=10  # Maximum number of tweets per thread
